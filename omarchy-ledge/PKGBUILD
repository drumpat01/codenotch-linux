# Maintainer: Patrick <patrickbstewart@gmail.com>
pkgname=ledge-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Hover-to-expand notch for Hyprland/Omarchy: music, focus timer, tasks, shortcuts, GitHub activity'
arch=('any')
url='https://github.com/drumpat01/codenotch-linux'
license=('MIT')
depends=('quickshell' 'libnotify' 'github-cli' 'qt6-declarative')
optdepends=('xdg-terminal-exec: open project folders in a terminal')
source=()

package() {
    cd "$startdir"
    install -d "$pkgdir/usr/share/ledge" "$pkgdir/usr/bin"
    cp -r qml "$pkgdir/usr/share/ledge/qml"
    install -Dm644 config.example.json "$pkgdir/usr/share/ledge/config.example.json"
    install -Dm755 bin/ledge "$pkgdir/usr/bin/ledge"
}
